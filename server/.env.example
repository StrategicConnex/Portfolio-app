# ─── Express API server configuration ─────────────────────────────────────────

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# JWT secrets — generate strong values with: openssl rand -hex 32
# (JWT_SECRET must be at least 32 characters)
JWT_SECRET=replace-me-with-a-64-char-random-hex-string
JWT_REFRESH_SECRET=replace-me-with-another-64-char-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — comma-separated list of allowed origins, or * to allow all
ALLOWED_ORIGINS=http://localhost:3000

# Optional admin bootstrap — set both to create an admin account on startup
# (needed to use GET /api/users).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# Number of trusted reverse-proxy hops (1 = nginx/Railway/Fly in front, 0 = none)
TRUST_PROXY=1

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
