# ─── AI Copilot (Ask Juan AI) ────────────────────────────────────────────────
# Requerida para que el copilot funcione (/api/ask-ai).
OPENROUTER_API_KEY=

# Pool de modelos FREE-ONLY, separados por coma (costo $0 en OpenRouter).
# El copilot NUNCA usa modelos pagos: cualquier id que no termine en ":free"
# (o el router `openrouter/free`) se descarta en tiempo de ejecución.
# Default (verificado contra el catálogo free live — el tier free cambia, un modelo
# delistado responde 404 y quema un slot del pool hasta que se lo quita):
#   nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free,cohere/north-mini-code:free,
#   google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
OPENROUTER_MODEL_POOL=

# ─── Formulario de contacto (Resend) ────────────────────────────────────────
# Requeridas para que /api/contact envíe email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=portfolio@juanpalacios.vercel.app

# ─── Rate limiting distribuido (opcional) ───────────────────────────────────
# Sin estas variables, el rate limit cae al fallback in-memory (por instancia).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Observabilidad (opcional) ───────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# ─── Build / Deploy ──────────────────────────────────────────────────────────
# Dominio desplegado (default: juanpalacios.vercel.app). Solo público.
NEXT_PUBLIC_VERCEL_URL=juanpalacios.vercel.app

# Arma la ruta de solo-tests /test-error (para el e2e del error boundary en CI).
# No se setea en producción real.
NEXT_PUBLIC_E2E_ERROR_ROUTE=
