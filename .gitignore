# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# local tool database (Freebuff)
.freebuff/

# playwright test report (generated artifact)
playwright-report/
test-results/
.lighthouseci/
.tmp-meta/

# download-stats log (registro local de descargas)
.data/

# auditoría visual (capturas Playwright)
.audit/

# capturas de pantalla y PNGs locales (sin versionar)
screenshots/
*.png

# tooling local del agente (hooks.json contiene una API key en texto plano)
hooks.json
.serena/

# paquete hermano server/ — dependencias y build (las fuentes sí se versionan)
/server/node_modules/
/server/dist/