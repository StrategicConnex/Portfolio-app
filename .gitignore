# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# local tool database (Freebuff)
.freebuff/

# playwright test report (generated artifact)
playwright-report/

# standalone express api server (server/)
/server/node_modules
/server/dist
/server/.env
!/server/.env.example

# gltf-transform pipeline output (scripts/glb-pipeline.mjs)
/.glb-pipeline/

# Screenshots de QA regenerables (verify-*.mjs)
artwork/living-datacenter/refcheck/
